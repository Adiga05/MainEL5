# ======================================================================
# Urban Flood Risk and Emergency Accessibility System
# Global Environment Configuration (.env.example)
# ======================================================================

# ── Database (PostgreSQL with PostGIS) ───────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=civix_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/civix_db

# (Optional fallback for local offline development without PostgreSQL service)
# DATABASE_URL=sqlite:///./data/civix.db

# ── Backend Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
SECRET_KEY=urban-flood-risk-system-secret-key-2024
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Study Area Boundaries (Bommanahalli–Marathahalli Corridor) ───────
STUDY_AREA_ID=bommanahalli_marathahalli
STUDY_AREA_NAME="Bommanahalli–Marathahalli Corridor, Bengaluru"
STUDY_AREA_MIN_LAT=12.885
STUDY_AREA_MAX_LAT=12.995
STUDY_AREA_MIN_LON=77.610
STUDY_AREA_MAX_LON=77.725
STUDY_AREA_CENTER_LAT=12.938
STUDY_AREA_CENTER_LON=77.675
STUDY_AREA_DEFAULT_ZOOM=13

# ── Machine Learning & MLflow Tracking ──────────────────────────────
ACTIVE_MODEL=xgboost
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Frontend Configuration ───────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
